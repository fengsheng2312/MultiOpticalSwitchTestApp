<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MultiOpticalSwitchTestApp</RootNamespace>
    <Nullable>annotations</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

	  <!-- 版本号统一在这里维护，发布脚本会自动修改 -->
	  <Version>1.0.2</Version>
	  <FileVersion>1.0.2.0</FileVersion>
	  <AssemblyVersion>1.0.2.0</AssemblyVersion>
	  <!-- 构建时间，编译时自动生成（不需要手动改） -->

	  
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Config\zero_calibration.json" />
	  <AssemblyMetadata Include="BuildTime" Value="$(BuildTime)" />
  </ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\logo.ico" />
	</ItemGroup>
	
  <ItemGroup>
    <Content Include="Config\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
	  
  </ItemGroup>
	<!-- 把 JSON 配置文件复制到输出目录 -->
	<ItemGroup>

		<None Update="Plugins\GenericScpiPowerMeter\configs\**\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- 编译后确保输出目录下有 Plugins\configs 文件夹，并把配置文件移进去 -->
	<Target Name="OrganizePluginConfigs" AfterTargets="Build">
		<MakeDir Directories="$(OutputPath)Plugins\configs" />
		<ItemGroup>
			<JsonFiles Include="$(OutputPath)Plugins\GenericScpiPowerMeter\configs\**\*.json" />
		</ItemGroup>
		<Copy SourceFiles="@(JsonFiles)" DestinationFolder="$(OutputPath)Plugins\configs\" SkipUnchangedFiles="true" />
		<RemoveDir Directories="$(OutputPath)Plugins\GenericScpiPowerMeter" />
	</Target>
	
  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.3" />
    <PackageReference Include="EPPlus" Version="8.6.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SunnyUI" Version="3.9.8" />
    <PackageReference Include="SunnyUI.Common" Version="3.9.8" />
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.11" />
      </ItemGroup>

  <ItemGroup>
    <Folder Include="Protocol\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Updater/**/*.cs" />
  </ItemGroup>
</Project>